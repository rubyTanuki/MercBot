DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Comma-separated server IDs; commands are registered in each.
DISCORD_GUILD_ID=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# The pitches forum channel /accept reads.
PITCHES_CHAT_ID=

# Optional; the values shown are the defaults.
# Linear team keys for pitch issues and their photo/graphic sub-issues.
# WRITERS_TEAM_KEY=WRI
# VISUALS_TEAM_KEY=VIS
# Pitch forum tags /accept looks for (case-insensitive).
# ACCEPTED_TAG=Accepted
# POSTPONED_TAG=Accepted - Postponed
# PITCH_WINDOW_DAYS=90
# Comma-separated Linear labels, each used from whichever team has it. Sections create a pitch's main
# issue and are /accept's team choices; visuals add a sub-issue. Defaults: the writers team's labels,
# and the visuals team's other labels.
# ACCEPT_SECTIONS=News,Life and Arts,Sports,Opinion,Comics
# ACCEPT_VISUALS=Photography,Graphics
# TIMEZONE=America/Chicago
# Public URL the Linear OAuth callback is served under: https:// plus the tunnel's hostname.
# PUBLIC_BASE_URL=https://discord-dev.tostr.ai
